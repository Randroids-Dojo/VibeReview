{
  "manifest_version": 3,
  "name": "VibeReview Capture Bridge",
  "version": "0.1.2",
  "description": "Sends browser game state snapshots to the local VibeReview macOS app.",
  "permissions": [],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:37717/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
